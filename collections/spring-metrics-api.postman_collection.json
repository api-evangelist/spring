        {
          "id": "37a80401-0842-426d-9233-d4d077c7645d",
          "name": "Get Metric Value",
          "request": {
            "name": "Get Metric Value",
            "description": {
              "content": "Returns the current value(s) for a specific metric. Metrics are identified by their dot-notation name (e.g., jvm.memory.used, http.server.requests). Results can be filtered by tag using the tag query parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metrics",
                ":requiredMetricName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Tag filter in KEY:VALUE format (can be repeated for multiple tags). Example: area:heap or area:heap&tag=id:G1+Eden+Space"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "requiredMetricName",
                  "description": "(Required) Metric name in dot notation"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.spring-boot.actuator.v3+json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "f85f31f0-5dfe-4c11-90ab-f5af3457831f",
              "name": "Metric value and measurements",
              "originalRequest": {
                "url": {
                  "path": [
                    "metrics",
                    ":requiredMetricName"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "tag",
                      "value": "area:heap"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "requiredMetricName",
                      "description": "(Required) Metric name in dot notation"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/vnd.spring-boot.actuator.v3+json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/vnd.spring-boot.actuator.v3+json"
                }
              ],
              "body": "{\n  \"name\": \"jvm.memory.used\",\n  \"description\": \"string\",\n  \"baseUnit\": \"bytes\",\n  \"measurements\": [\n    {\n      \"statistic\": \"VALUE\",\n      \"value\": 123456789\n    },\n    {\n      \"statistic\": \"VALUE\",\n      \"value\": 123456789\n    }\n  ],\n  \"availableTags\": [\n    {\n      \"tag\": \"string\",\n      \"values\": [\n        \"string\",\n        \"string\"\n      ]\n    },\n    {\n      \"tag\": \"string\",\n      \"values\": [\n        \"string\",\n        \"string\"\n      ]\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
