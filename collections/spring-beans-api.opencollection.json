{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Boot Actuator Beans API",
    "version": "3.x"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Beans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Application Beans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/actuator/beans"
          },
          "docs": "Returns a complete list of Spring beans instantiated in the application context, along with their type, scope, and dependencies."
        }
      ]
    }
  ],
  "bundled": true
}