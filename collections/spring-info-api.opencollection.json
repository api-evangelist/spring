{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spring Boot Actuator Beans Info API",
    "version": "3.x"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Application Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/actuator/info"
          },
          "docs": "Returns application information including build details, Git commit info, Java runtime version, and any custom info contributors registered in the application context."
        }
      ]
    }
  ],
  "bundled": true
}