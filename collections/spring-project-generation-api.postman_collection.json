                  "disabled": false,
                  "key": "type",
                  "value": "maven-project",
                  "description": "Project type (build system)"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "java",
                  "description": "Programming language"
                },
                {
                  "disabled": false,
                  "key": "bootVersion",
                  "value": "<string>",
                  "description": "Spring Boot version"
                },
                {
                  "disabled": false,
                  "key": "baseDir",
