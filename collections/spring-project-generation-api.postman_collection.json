                  "description": "Root Java package name"
                },
                {
                  "disabled": false,
                  "key": "packaging",
                  "value": "jar",
                  "description": "Packaging type"
                },
                {
                  "disabled": false,
                  "key": "javaVersion",
                  "value": "21",
                  "description": "Java version"
                },
                {
                  "disabled": false,
                  "key": "dependencies",
                  "value": "<string>",
