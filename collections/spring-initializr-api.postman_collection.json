          "name": "Get Initializr Metadata",
          "request": {
            "name": "Get Initializr Metadata",
            "description": {
              "content": "Returns the full metadata document describing all available project types, Spring Boot versions, dependencies, languages, Java versions, packaging options, and their defaults. Clients use this to present choices to the user before generating a project.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "6ef1ba28-6d91-48d1-a9fa-28a20daa5db8",
              "name": "Spring Initializr metadata",
              "originalRequest": {
