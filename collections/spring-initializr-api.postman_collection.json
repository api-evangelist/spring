                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"dependencies\": {\n    \"type\": \"hierarchical-multi-select\",\n    \"values\": [\n      {\n        \"name\": \"Web\",\n        \"values\": [\n          {\n            \"id\": \"web\",\n            \"name\": \"Spring Web\",\n            \"description\": \"Build web, including RESTful, applications using Spring MVC.\",\n            \"compatibilityRange\": \"[3.0.0,4.0.0-M1)\"\n          },\n          {\n            \"id\": \"web\",\n            \"name\": \"Spring Web\",\n            \"description\": \"Build web, including RESTful, applications using Spring MVC.\",\n            \"compatibilityRange\": \"[3.0.0,4.0.0-M1)\"\n          }\n        ]\n      },\n      {\n        \"name\": \"Web\",\n        \"values\": [\n          {\n            \"id\": \"web\",\n            \"name\": \"Spring Web\",\n            \"description\": \"Build web, including RESTful, applications using Spring MVC.\",\n            \"compatibilityRange\": \"[3.0.0,4.0.0-M1)\"\n          },\n          {\n            \"id\": \"web\",\n            \"name\": \"Spring Web\",\n            \"description\": \"Build web, including RESTful, applications using Spring MVC.\",\n            \"compatibilityRange\": \"[3.0.0,4.0.0-M1)\"\n          }\n        ]\n      }\n    ]\n  },\n  \"type\": {\n    \"type\": \"string\",\n    \"default\": \"string\",\n    \"values\": [\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": false\n      },\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      }\n    ]\n  },\n  \"bootVersion\": {\n    \"type\": \"string\",\n    \"default\": \"string\",\n    \"values\": [\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": false\n      },\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      }\n    ]\n  },\n  \"packaging\": {\n    \"type\": \"string\",\n    \"default\": \"string\",\n    \"values\": [\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      },\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": false\n      }\n    ]\n  },\n  \"javaVersion\": {\n    \"type\": \"string\",\n    \"default\": \"string\",\n    \"values\": [\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      },\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": false\n      }\n    ]\n  },\n  \"language\": {\n    \"type\": \"string\",\n    \"default\": \"string\",\n    \"values\": [\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      },\n      {\n        \"id\": \"string\",\n        \"name\": \"string\",\n        \"default\": true\n      }\n    ]\n  }\n}",
